# docker-compose için ortam değişkenleri.
# Kullanım:  cp .env.example .env   (sonra değerleri düzenle)

# MySQL root parolası (backend datasource + mysql servisi bunu paylaşır)
DB_PASSWORD=changeme_root_pw

# JWT imzalama anahtarı — min 32 karakter. Prod'da güçlü + gizli bir değer koy.
JWT_SECRET=dev-only-secret-key-at-least-32-characters-long-!!!
