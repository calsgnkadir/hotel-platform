# Backend API URL (build anında koda gömülür; sır değildir)
# ─────────────────────
# Geliştirme: BOŞ bırak — Vite proxy '/api' ve '/ws' isteklerini localhost:8080'e
#   yönlendirir (vite.config.js).
# Canlı (Vercel): backend'in tam adresi ZORUNLU, sonda "/" yok:
#   VITE_API_URL=https://api.kadrom.me
#   Vercel derlemesinde boş ya da localhost ise derleme durur (vite.config.js).
# Vitrin önizlemesi (backend yok): VITE_SHOWCASE=true — bu kontrol uygulanmaz.
VITE_API_URL=
