# AjansHotel — PRODUCTION ortam degiskenleri.
#   cp deploy/prod/.env.prod.example deploy/prod/.env.prod
# sonra doldur. .env.prod repoya GIRMEZ (.gitignore'da).

# ── ZORUNLU ──────────────────────────────────────────────────────
# Alan adin (DNS'i sunucu IP'sine A kaydiyla isaret etmeli).
# Caddy bunun icin otomatik HTTPS sertifikasi alir.
DOMAIN=ajanshotel.example.com

# Tarayicinin gordugu tam adres. DOMAIN ile ayni host, https ile.
# KRITIK: frontend build'ine gomulur; REST + WebSocket bu adrese gider.
PUBLIC_URL=https://ajanshotel.example.com

# MySQL root parolasi — guclu ve rastgele uret.
DB_PASSWORD=

# JWT imzalama anahtari — en az 32 karakter, tercihen base64:
#   openssl rand -base64 48
JWT_SECRET=

# ── OPSIYONEL (verilmezse ilgili ozellik kapali, uygulama yine acilir) ──
# Gorsel yukleme (avatar/logo/ilan foto):
# CLOUDINARY_URL=cloudinary://APIKEY:SECRET@CLOUDNAME

# Google ile giris:
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# E-posta (dogrulama / sifre sifirlama):
# RESEND_API_KEY=re_...

# KVKK alan sifreleme (hassas alanlar DB'de sifreli):
#   openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# ── HTTP-ONLY HIZLI TEST (alan adin yoksa) ───────────────────────
# Ustteki DOMAIN/PUBLIC_URL yerine sunlari kullan, digerlerini ayni birak:
#   DOMAIN=:80
#   PUBLIC_URL=http://SUNUCU_IP
#   COOKIE_SECURE=false
