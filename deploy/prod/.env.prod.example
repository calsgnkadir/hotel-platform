# Kadrom — PRODUCTION ortam degiskenleri.
#   cp deploy/prod/.env.prod.example deploy/prod/.env.prod
# sonra doldur. .env.prod repoya GIRMEZ (.gitignore'da). Dosya izni: chmod 600.
# Asagidaki ZORUNLU alanlardan biri bos kalirsa docker compose baslamaz ya da
# backend acilista durur (ProductionSafetyConfiguration) — bu bilerek boyle.

# ── ZORUNLU: adres ───────────────────────────────────────────────
# Alan adin (DNS'i sunucu IP'sine A kaydiyla isaret etmeli).
# Caddy bunun icin otomatik HTTPS sertifikasi alir.
DOMAIN=kadrom.me

# Tarayicinin gordugu tam adres. DOMAIN ile ayni host, https ile (http/localhost reddedilir).
# KRITIK: frontend build'ine gomulur; REST + WebSocket bu adrese gider.
PUBLIC_URL=https://kadrom.me

# ── ZORUNLU: veritabani ve anahtarlar ────────────────────────────
# Birbirinden farkli, guclu parolalar kullan. Root backend'e verilmez.
MYSQL_ROOT_PASSWORD=
# Yalniz hotel_platform semasina yetkili kadrom_app kullanicisi:
DB_PASSWORD=

# JWT imzalama anahtari — guvenli rastgele uretec ile, en az 48 bayt:
#   openssl rand -base64 48
#   (PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48)))
JWT_SECRET=

# KVKK alan sifreleme — 256-bit base64 (kaybedersen sifreli alanlar okunamaz, yedekle):
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── ZORUNLU: entegrasyonlar ──────────────────────────────────────
# Gorsel yukleme (avatar/logo/ilan foto). 'test' iceren deger reddedilir.
CLOUDINARY_URL=

# E-posta (dogrulama / sifre sifirlama / ekip listesi). Anahtar 're_' ile baslar.
# Gonderen adres Resend'de dogrulanmis alan adinda olmali (@resend.dev kabul edilmez).
RESEND_API_KEY=
RESEND_FROM=
# RESEND_FROM_NAME=Kadrom

# Web push (VAPID) — BIR KEZ uret, sakla, bir daha degistirme (degisirse tum
# abonelikler gecersiz olur). Uretim: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@kadrom.me

# ── ISTEGE BAGLI (bos = ozellik kapali, uygulama yine acilir) ───
# Google ile giris (ikisi birlikte; redirect URI: https://<DOMAIN>/login/oauth2/code/google):
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Adres arama (Nominatim) iletisim adresi. Bos ise RESEND_FROM kullanilir.
# GEO_CONTACT_EMAIL=destek@kadrom.me

# SMS (acil ilan + yedek aktivasyonu; push'a ek). false iken gercek SMS gitmez.
# SMS_ENABLED=true
# SMS_PROVIDER=netgsm
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_HEADER=

# iyzico odeme (isletme aboneligi). BOS = ODEME KAPALI: abonelik satin alinamaz;
# ucretsiz planin "ayni anda en fazla 5 aktif ilan" siniri YINE uygulanir.
# Sandbox anahtari prod'da KABUL EDILMEZ (herkese acik test kartiyla bedava abonelik alinirdi).
# CANLIYA GECIS icin ONCE kayitli sirket (sahis sirketi yeter) + gercek iyzico merchant
# hesabi sart; onaylaninca sunlari doldur (callback https olmali):
#   IYZICO_API_KEY=<gercek merchant anahtari>
#   IYZICO_SECRET_KEY=<gercek secret>
#   IYZICO_BASE_URL=https://api.iyzipay.com
#   IYZICO_CALLBACK_URL=https://<DOMAIN>/api/billing/callback
# Ucretli abonelikte ayni anda en fazla aktif ilan (varsayilan 10):
# BILLING_PAID_CONCURRENT_LISTINGS=10

# NOT: HTTP-only (alan adsiz, COOKIE_SECURE=false) kurulum prod profilinde artik
# ACILMAZ. Once alan adi + HTTPS; yerel deneme icin kokteki docker-compose.yml.
